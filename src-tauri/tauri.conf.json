{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ztunes",
  "version": "1.0.4-rc.5",
  "identifier": "app.spotless.desktop",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Ztunes",
        "width": 1280,
        "height": 832,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "Free, ad-free desktop music player",
    "copyright": "GPL-3.0-or-later. Based on Limusic (github.com/SimoHypers/limusic)."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fjenn/spotless/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5OTBGMjE5NTI0MjJFQzUKUldURkxrSlNHZktRR1N5dFUzRVJ2aVhPS2h1UVJkM0REOWp6aDBFaUVSNHFma1c1RmdPNzdOWEkK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "spotless",
          "encore"
        ]
      }
    }
  }
}
